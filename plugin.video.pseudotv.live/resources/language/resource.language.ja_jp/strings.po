msgid "Hide OSD on change"
msgstr "変更時にOSDを非表示"

msgctxt "#33001"
msgid "[COLOR=yellow][B]Notice:[/B][/COLOR] Writes detailed debug info to kodi.log.\n[B]Default:[/B] [B][COLOR=white]ON[/COLOR][/B] - disable unless troubleshooting."
msgstr "[COLOR=yellow][B]注意:[/B][/COLOR] 詳細なデバッグ情報をkodi.logに書き込みます。\n[B]既定:[/B] [B][COLOR=white]ON[/COLOR][/B] - トラブルシューティング以外では無効にしてください。"

