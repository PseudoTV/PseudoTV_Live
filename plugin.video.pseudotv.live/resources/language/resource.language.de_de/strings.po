msgctxt "#32217"
msgid "Install Bonjour (QR)"
msgstr "Bonjour installieren (QR)"

msgctxt "#33046"
msgid "Remove a paired multiroom server from the discovered servers list."
msgstr "Ein gekoppeltes Multiroom-Server aus der Liste der erkannten Server entfernen."

msgctxt "#33125"
msgid "Include Coming Soon Trailers from the IMDB Trailer plugin."
msgstr "„Coming Soon\"-Trailer aus dem IMDB-Trailer-Plugin einschließen."

msgctxt "#33213"
msgid "Run this instance as a client with no local channels.\n[B]Default:[/B] [B][COLOR=white]OFF[/COLOR][/B]"
msgstr "Diese Instanz als Client ohne lokale Kanäle ausführen.\n[B]Standard:[/B] [B][COLOR=white]AUS[/COLOR][/B]"

msgctxt "#33013"
msgid "AutoTune from Recommended (Supported) services installed on Kodi and supplied by IPTV Manager. Support does not imply a relation between projects, PseudoTV is not responsible for the content provided by third-party plugins."
msgstr "AutoTune von empfohlenen (unterstützten) Diensten, die auf Kodi installiert und von IPTV Manager bereitgestellt werden. Die Unterstützung impliziert keine Verbindung zwischen den Projekten. PseudoTV ist nicht für Inhalte verantwortlich, die von Drittanbieter-Plugins bereitgestellt werden."

msgctxt "#30049"
msgid "Duration Source"
msgstr "Dauer-Quelle"

msgctxt "#33224"
msgid "Subfolder levels to scan.\n[B]Default:[/B] [B][COLOR=white]1[/COLOR][/B] - 0 = root only."
msgstr "Zu durchsuchende Unterordner-Ebenen.\n[B]Standard:[/B] [B][COLOR=white]1[/COLOR][/B] - 0 = nur Stammverzeichnis."

msgctxt "#30180"
msgid "Group TV shows in blocks"
msgstr "TV-Serien in Blöcken gruppieren"

msgctxt "#33153"
msgid "Offer to restart when progress passes this percent.\n[B]Default:[/B] [B][COLOR=white]55%[/COLOR][/B] - 0 disables."
msgstr "Neustart anbieten, wenn der Fortschritt diesen Prozentsatz überschreitet.\n[B]Standard:[/B] [B][COLOR=white]55%[/COLOR][/B] - 0 deaktiviert."
