msgctxt "#32279"
msgid "No content available - check channel configuration"
msgstr "No hay contenido disponible - compruebe la configuración del canal"

msgctxt "#32276"
msgid "Failed to save to remote server."
msgstr "Error al guardar en el servidor remoto."

msgctxt "#32277"
msgid "No Guide Data - Check Back Later"
msgstr "Sin datos de guía - Vuelva a comprobar más tarde"

msgctxt "#32278"
msgid "Enable automatic PVR reload? This lets PseudoTV Live refresh channels and guide data when they change. Without it, you must manually reload the PVR."
msgstr "¿Habilitar la recarga automática de PVR? Esto permite a PseudoTV Live actualizar los canales y los datos de la guía cuando cambian. Sin ella, debe recargar el PVR manualmente."

