msgctxt "#33063"
msgid "Group EPG guide entries by category type in XMLTV output. [Default: Disabled]"
msgstr "Agrupar entradas de la guía EPG por tipo de categoría en la salida XMLTV. [Predeterminado: Desactivado]"

msgctxt "#32117"
msgid "Clear M3U/XMLTV/Genres cache"
msgstr "Limpiar caché de M3U/XMLTV/Géneros"

msgctxt "#32118"
msgid "Clean Start"
msgstr "Inicio limpio"

msgctxt "#34180"
msgid "Export M3U/XMLTV/genres files"
msgstr "Exportar archivos M3U/XMLTV/géneros"

msgctxt "#30061"
msgid "Playback Seek Tolerance (Seconds)"
msgstr "Tolerancia de búsqueda de reproducción (Segundos)"

