msgstr "Movendo não assistidos primeiro"

msgctxt "#33052"
msgid "Save file-parsed runtime to Kodi database. Improves EPG accuracy. [Default: Disabled] [Recommended: Enabled]"
msgstr "Salvar tempo de execução analisado no banco de dados do Kodi. Melhora a precisão do EPG. [Padrão: Desativado] [Recomendado: Ativado]"

