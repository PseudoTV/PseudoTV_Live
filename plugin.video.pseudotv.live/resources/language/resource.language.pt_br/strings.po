msgctxt "#32118"
msgid "Clean Start"
msgstr "Início Limpo"

msgctxt "#32119"
msgid "Clear M3U/XMLTV/Genres cache and reset settings/PVR configuration"
msgstr "Limpar cache M3U/XMLTV/Gêneros e redefinir configurações/configuração PVR"

msgctxt "#34068"
msgid "Saving data, please wait..."
msgstr "Salvando dados, aguarde..."

msgctxt "#32281"
msgid "- Delete Rule"
msgstr "- Excluir Regra"

msgctxt "#34181"
msgid "Write pseudotv.m3u, pseudotv.xml and genres.xml to the cache folder. Disabled by default: the guide and playlist are served from the SQLite cache, which is faster and avoids file-write races. Enable only if you use a local-file PVR (iptvsimple) configuration or need the files for external tools."
msgstr "Escrever pseudotv.m3u, pseudotv.xml e genres.xml na pasta de cache. Desativado por padrão: o guia e a playlist são servidos do cache SQLite, que é mais rápido e evita corridas de gravação em arquivo. Ative apenas se você usar uma configuração PVR de arquivo local (iptvsimple) ou precisar dos arquivos para ferramentas externas."

msgctxt "#30062"
msgid "Adjust Seek Threshold (Percentage)"
msgstr "Ajustar Limiar de Busca (Porcentagem)"

msgctxt "#32278"
msgid "Enable automatic PVR reload? This lets PseudoTV Live refresh channels and guide data when they change. Without it, you must manually reload the PVR."
msgstr "Ativar recarga automática do PVR? Isso permite que o PseudoTV Live atualize os canais e dados do guia quando eles mudarem. Sem isso, você deve recarregar o PVR manualmente."

msgctxt "#32117"
msgid "Clear M3U/XMLTV/Genres cache"
msgstr "Limpar cache M3U/XMLTV/Gêneros"

msgctxt "#32277"
msgid "No Guide Data"
msgstr "Sem Dados de Guia"

msgctxt "#33065"
msgid "Path to a YouTube cookies.txt exported from a logged-in browser session (Netscape format). YouTube bot-checks anonymous yt-dlp requests; a valid session cookie (SID/HSID/SSID) avoids it so video durations resolve. Leave empty to use the addon's generated cookie file."
msgstr "Caminho para um cookies.txt do YouTube exportado de uma sessão de navegador conectado (formato Netscape). O YouTube verifica bots em solicitações anônimas do yt-dlp; um cookie de sessão válido (SID/HSID/SSID) evita isso para que as durações dos vídeos sejam resolvidas. Deixe vazio para usar o arquivo de cookie gerado pelo addon."

msgctxt "#32279"
msgid "No content available - check channel configuration"
msgstr "Nenhum conteúdo disponível - verifique a configuração do canal"

msgctxt "#30500"
msgid "YouTube Cookies File"
msgstr "Arquivo de Cookies do YouTube"

msgctxt "#33063"
msgid "Group EPG guide entries by category type in XMLTV output. [Default: Disabled]"
msgstr "Agrupar entradas do guia EPG por tipo de categoria na saída XMLTV. [Padrão: Desativado]"

msgctxt "#32276"
msgid "Failed to save to remote server."
msgstr "Falha ao salvar no servidor remoto."

msgctxt "#33064"
msgid "Enter custom guide data categories for use in the channel manager."
msgstr "Insira categorias personalizadas de dados do guia para uso no gerenciador de canais."

msgctxt "#32120"
