msgstr "Limpar entradas de cache M3U/XMLTV/Gêneros"

msgctxt "#34180"
msgid "Export M3U/XMLTV/genres files"
msgstr "Exportar arquivos M3U/XMLTV/gêneros"

msgctxt "#32121"
msgid "Force {name} to reload"
msgstr "Forçar recarga de {name}"

msgctxt "#30061"
msgid "Playback Seek Tolerance (Seconds)"
msgstr "Tolerância de Busca de Reprodução (Segundos)"

msgctxt "#32280"
msgid "- Edit Rule"
msgstr "- Editar Regra"

msgctxt "#33259"
msgid "Mark this channel to be rebuilt on next update. Toggle ON to force a channel refresh."
msgstr "Marque este canal para ser reconstruído na próxima atualização. Ative para forçar a atualização do canal."

msgctxt "#32303"
msgid "Unwatched First"
msgstr "Não assistidos primeiro"

msgctxt "#32000"
msgid "Something went wrong, Try again later..."
msgstr "Algo deu errado, tente novamente mais tarde..."

